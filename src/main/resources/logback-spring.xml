<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="stdout_json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- Logger for sensitive data (team-logs). Bruk: LoggerFactory.getLogger("secureLogger") -->
    <appender name="team-logs" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>team-logs.nais-system:5170</destination>
        <keepAliveDuration>30 seconds</keepAliveDuration>
        <writeTimeout>1 minute</writeTimeout>
        <reconnectionDelay>1 second</reconnectionDelay>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"google_cloud_project":"${GOOGLE_CLOUD_PROJECT}","nais_namespace_name":"${NAIS_NAMESPACE}","nais_pod_name":"${HOSTNAME}","nais_container_name":"${NAIS_APP_NAME}"}</customFields>
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <!-- additivity="false" hindrer at meldinger med personopplysninger også sendes til root-loggeren og stdout. -->
    <logger name="secureLogger" level="INFO" additivity="false">
        <appender-ref ref="team-logs"/>
    </logger>

    <!-- Oppslagslogg (ArcSight). Bruk: LoggerFactory.getLogger("auditLogger") -->
    <appender name="auditLogger" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>audit.nais:6514</destination>
        <writeBufferSize>128000</writeBufferSize>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- Prefikset identifiserer avsenderen. %nopex hindrer Logback i å legge til en stacktrace etter CEF-meldingen. -->
            <pattern>${HOSTNAME} ${NAIS_APP_NAME}: %msg%n%nopex</pattern>
        </encoder>
    </appender>

    <!-- additivity="false" hindrer at auditmeldinger med personopplysninger også sendes til root-loggeren og stdout. -->
    <logger name="auditLogger" level="INFO" additivity="false">
        <appender-ref ref="auditLogger"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="stdout_json"/>
    </root>

    <logger name="no.nav" level="WARN"/>
    <logger name="no.nav.familie" level="INFO"/>
</configuration>
